# Sätts automatiskt av Vercel när du kopplar en databas till projektet
# (Storage -> Create Database -> Neon Postgres, se README). Behövs inte
# lokalt – saknas den sparas intresseanmälningar i data/region-interest.json.
DATABASE_URL=

# Lösenordet till /admin, minst 12 tecken. Sätts i Vercel under
# Settings -> Environment Variables. Saknas det är adminsidan avstängd.
ADMIN_PASSWORD=
